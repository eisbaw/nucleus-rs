// Positive contract fixture (TASK-0012).
//
// Three kernels exercising scalar parameter and return types, the
// unit return form (effectful kernel with no return), and one
// no-arg pure kernel.

kernel add        : (f32, f32) -> f32   pure;
kernel scale_clip : (f32, f32, f32) -> f32   pure;
kernel emit_log   : (f32) -> ()   effectful;
kernel pi         : () -> f64   pure;
