// TASK-0274 negative fixture: a `loop v : reuse;` body with a strided
// `src[v * 2]` index. The reuse_inference pass (Stage 1, TASK-0261)
// rejects strided coefficients with ReuseInferenceError::Strided-
// AccessNotSupported (cf. reuse_inference.rs:322). Since TASK-0271
// cycle 88 promoted the driver to strict, the build now fails with
// the wrapped "reuse-inference error: ..." string the CLI surfaces
// to the user. This fixture's only job is to trigger that path.

const N : usize = 4;

data src : i32[N];
data dst : i32[N];

kernel load_src : ()        -> i32[N] effectful;
kernel save_dst : (i32[N])  -> ()     effectful;
kernel pass     : (i32)     -> i32    pure;

src <-- load_src();

// The strided index `v * 2` is the only point of this fixture; build
// fails at the reuse_inference pass (TASK-0271 strict promotion)
// BEFORE any runtime, so iteration bounds + array-size correctness
// are irrelevant — the IR-level affine-decomposition rejection is
// what fires.
for v : 0 .. 2 {
    dst[v] <-- pass(src[v * 2]);
}

save_dst(dst);
