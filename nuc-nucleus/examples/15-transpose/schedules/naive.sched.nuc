// Naive schedule: single worker, no decomposition.
//
// Landed cycle 204 (TASK-0341.01 AC#1). Every kernel runs on `host`;
// no cross-worker dataflow means no `transfer` directives. The result
// must be bit-identical to reference.bin.

schedule for "../prog.algo.nuc" {
    workers = { host };

    place load_input    on host;
    place save_output   on host;
    place xpose         on host;

    // No loop transforms.
    // No transfer directives — there are no cross-worker edges.
}
