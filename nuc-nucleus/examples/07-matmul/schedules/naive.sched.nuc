// Naive schedule: one worker, no decomposition.
//
// This is the smoke-test schedule. Every algorithm must produce
// correct output under naive.sched.nuc on every backend before any
// other schedule is allowed to claim correctness.

schedule for "../prog.algo.nuc" {
    workers = { host };

    place load_a on host;
    place load_b on host;
    place save_c on host;
    place madd   on host;

    // No loop transforms.
    // No transfer directives — there are no cross-worker edges.
}
