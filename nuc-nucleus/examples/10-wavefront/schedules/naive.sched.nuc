// Naive schedule: one worker, no decomposition.
//
// The smoke-test schedule. Single `host`, every kernel placed there,
// no loop transforms, no transfers. The wavefront algorithm has no
// loop in its dataflow (one load, one compute, one save), so there
// is nothing for `block=` / `partition=` to attach to even if a
// distributed schedule could be expressed. The diagonal-parallel
// schedule is GRAMMAR-DEFERRED (see prog.algo.nuc header); v2 only
// ships this single schedule.

schedule for "../prog.algo.nuc" {
    workers = { host };

    place load_input  on host;
    place save_output on host;
    place wavefront   on host;

    // No loop transforms.
    // No transfer directives — there are no cross-worker edges.
}
