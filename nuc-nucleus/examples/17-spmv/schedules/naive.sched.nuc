// Naive schedule: single worker, no decomposition.
//
// Landed cycle 210 (TASK-0341.03 AC#1). Every kernel runs on `host`;
// no cross-worker dataflow means no `transfer` directives. The result
// is bit-identical to reference.bin.

schedule for "../prog.algo.nuc" {
    workers = { host };

    place load_val     on host;
    place load_col_idx on host;
    place load_x       on host;
    place save_y       on host;
    place spmv_step    on host;

    // No loop transforms.
    // No transfer directives — there are no cross-worker edges.
}
