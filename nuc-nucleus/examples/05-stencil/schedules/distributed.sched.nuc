// Distributed schedule: 4 compute workers, async input streaming, sync output.
//
// Same algorithm as naive.sched.nuc, different mapping. The differential
// test in CI must show this produces bit-identical output to the naive
// schedule for the same input.

schedule for "../prog.algo.nuc" {
    workers = { host, w0, w1, w2, w3 };

    place load_image on host;
    place save_image on host;
    place blur3      on { w0, w1, w2, w3 };

    // Outer y-loop: row-band partition across the 4 compute workers.
    //
    // History:
    //   - Pre-cycle-70: `loop y : partition=rows;` was inert — parsed
    //     and lowered, but no downstream pass consumed it (silent
    //     no-op).
    //   - TASK-0249 (cycle 70) closed the silent-drop by making
    //     partition=rows reject at sched-lower as
    //     SchedLowerErrorKind::UnsupportedPartitionKind.
    //   - TASK-0258 (cycle 79c) landed the partition_rows consumer pass.
    //     The directive could lower, but the exact-divisible first cut
    //     refused: y-loop walks 1..H-1 = 1..15 (length 14), 14 % 4 != 0.
    //   - TASK-0262 (cycle 83) landed the floor-with-spillover remainder
    //     policy. 14 rows / 4 workers ⇒ bands (1..5, 5..9, 9..12, 12..15)
    //     — first 2 workers get 4 rows, last 2 get 3 (numpy.array_split
    //     style). The directive is RESTORED below.
    //   - TASK-0263 (cycle 83) wired halo widths into transfer_inject so
    //     each per-worker tile carries the halo strips its `blur3` reads
    //     from neighbouring bands. Without that step, the row-band
    //     partition would produce wrong output at the boundaries (each
    //     worker's blur3 needs grid[y-1] and grid[y+1] at the seam).
    loop y : partition=rows;

    // Inner loop: SIMD-friendly, with the reuse pattern that was the
    // unshipped piece in the 2013 thesis (slide a 3-wide window in x,
    // recycle 2 of 3 reads each step).
    loop x : block=64, vectorize=8, reuse;

    // host -> workers: pipelined async streaming, two row-bands in flight.
    // Event-driven notification (the backend must support it; a sync-only
    // backend rejects this schedule at compile time, by design).
    transfer img_in  : async, buffer=2, notify=event;

    // workers -> host: simple blocking write-back. Host waits for all
    // workers to finish before save_image runs.
    transfer img_out : sync;
}
