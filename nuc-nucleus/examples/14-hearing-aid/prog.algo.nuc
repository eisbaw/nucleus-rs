// Hearing-aid pipeline — finite-frame test version.
//
// A hearing aid has three logical subsystems:
//   - FE (front-end): analog microphone capture, speaker output.
//   - DSP: FFT-based noise reduction, equalization, gain.
//   - RF: Bluetooth receive (e.g. phone call) and transmit.
//
// Audio flows in two directions simultaneously:
//   mic    -> DSP -> speaker        (hear yourself + ambient + BT)
//   mic    -> DSP -> BT out         (your voice to the other end)
//   BT in  -> DSP -> speaker        (other-end audio mixed in)
//
// What this example demonstrates:
//   - Three heterogeneous worker classes (FE, DSP, RF).
//   - Fork-and-merge dataflow (mic + BT merge in DSP; DSP forks to
//     speaker and BT out).
//   - Bidirectional flow over the same workers (RF both receives and
//     transmits; FE both captures and emits).
//   - Peripheral IO via effectful kernels.
//
// What this example does NOT demonstrate (out of v2 scope):
//   - Real-time deadlines. A deployed hearing aid needs <10ms
//     ear-to-ear latency; v2 has no `deadline=` directive.
//   - Continuous unbounded operation. v2 algorithms terminate; this
//     example uses a finite frame count for testability.
//   - Peripheral interrupts as first-class. fe_capture / rf_receive
//     are effectful kernels that, in the test build, read from
//     canned input files; on Renode they read from simulated I2S
//     and Bluetooth controllers; on real hardware they'd block on
//     DMA-complete IRQs (a backend concern, not an algorithm one).


const SAMPLES_PER_FRAME : usize = 256;   // ~16 ms at 16 kHz
const N_FRAMES          : usize = 1000;  // finite for the differential test


// Per-frame audio buffers, indexed by frame number.
data mic_in       : f32[N_FRAMES][SAMPLES_PER_FRAME];
data bt_in        : f32[N_FRAMES][SAMPLES_PER_FRAME];
data spk_out      : f32[N_FRAMES][SAMPLES_PER_FRAME];
data bt_out       : f32[N_FRAMES][SAMPLES_PER_FRAME];


// Peripheral IO — effectful. In the test build, these read/write
// canned WAV-equivalent binaries. The Rust function bodies in
// kernels.rs decide what "read" means for the target.
kernel fe_capture  : ()                          -> f32[SAMPLES_PER_FRAME]   effectful;
kernel rf_receive  : ()                          -> f32[SAMPLES_PER_FRAME]   effectful;
kernel fe_emit     : (f32[SAMPLES_PER_FRAME])    -> ()                       effectful;
kernel rf_transmit : (f32[SAMPLES_PER_FRAME])    -> ()                       effectful;

// Pure DSP — the meat of the hearing aid. Body in kernels.rs runs FFT,
// applies a noise-reduction spectral mask, equalisation, and gain.
kernel mix2        : (f32[SAMPLES_PER_FRAME], f32[SAMPLES_PER_FRAME])
                                                 -> f32[SAMPLES_PER_FRAME]   pure;
kernel denoise     : (f32[SAMPLES_PER_FRAME])    -> f32[SAMPLES_PER_FRAME]   pure;


// Steady-state pipeline. Each frame:
//   1. Capture mic and receive BT in parallel (independent peripheral reads).
//   2. Outbound branch: denoise mic only, transmit over BT.
//   3. Inbound branch: mix BT with mic, denoise, send to speaker.
//
// Note: denoise appears twice — once for the outbound path, once for
// the inbound. Pure kernels can fire many times; the schedule decides
// whether they share a worker.
for frame : 0 .. N_FRAMES {
    mic_in[frame] <-- fe_capture();
    bt_in[frame]  <-- rf_receive();

    // Outbound: clean mic only -> BT.
    bt_out[frame] <-- denoise(mic_in[frame]);
    rf_transmit(bt_out[frame]);

    // Inbound: mic + BT -> denoise -> speaker.
    spk_out[frame] <-- denoise(mix2(mic_in[frame], bt_in[frame]));
    fe_emit(spk_out[frame]);
}
