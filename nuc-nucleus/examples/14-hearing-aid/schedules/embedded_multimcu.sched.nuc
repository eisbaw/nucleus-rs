// Embedded multi-MCU schedule: three MCUs of different classes
// representing the three subsystems of a real hearing aid.
//
// **M11 design target.** This schedule places the per-frame
// peripheral kernels (fe_capture / rf_receive / fe_emit /
// rf_transmit) that the EMBEDDED algorithm shape declares. As of
// TASK-0054.01 (M11 entry) the `schedule for` target below points at
// the dedicated `../prog.embedded.algo.nuc` (the per-frame variant),
// NOT the tier-1 `../prog.algo.nuc` (bulk IO). The two algorithm
// shapes share `mix2` + `denoise` but differ in IO kernels; the
// option-(a) separate-file decision is recorded in
// prog.embedded.algo.nuc's header.
//
// As of TASK-0054.01 every kernel placed below resolves against
// prog.embedded.algo.nuc. Whether this schedule LOWERS cleanly
// through sched_lower / link / acfg is the subject of TASK-0192
// (M11 lowering-admission de-risk); deep-codegen gaps discovered
// there are filed as TASK-0049 subtasks. e2e-matrix.toml still marks
// all 7 embedded_multimcu cells [[skip]] (the e2e harness hardcodes
// prog.algo.nuc per example, so it cannot drive this variant yet —
// harness + stateful kernels.rs + Renode substrate are TASK-0049 /
// TASK-0054.01 part 2-4 deep-codegen follow-ups).
//
// This is the schedule M11 needs to compile and validate in Renode
// co-simulation. Interconnect DECIDED = UART hub (Renode has no
// MCU-to-MCU SPI link — TASK-0049.01); FE_MCU + DSP_MCU + RF_MCU
// connected over the wired UART hub.
//
// What's new compared to earlier examples:
//   - Three worker CLASSES, not just three workers. The classes
//     declare what each MCU is good at: FE has analog IO and small
//     memory, DSP has SIMD + TCM, RF has the radio.
//   - Memory regions are explicit. The frame buffers live in shared
//     SRAM accessible to all three MCUs. The dsp_core class also
//     declares a per-worker tightly-coupled (TCM) region, but no data
//     is placed there in this schedule — the i32 denoise is a 3-wide
//     sliding sum needing no scratch (there is NO FFT; see the
//     prog.embedded.algo.nuc header re: PRD §10.1 integer-only). The
//     TCM region is kept as a topology declaration for the M11 design
//     target, not because anything currently uses it.
//   - Async transfers with buffering so producer MCUs don't stall
//     waiting for consumer MCUs.

schedule for "../prog.embedded.algo.nuc" {

    // ---------- worker topology ----------

    worker_class fe_core {
        simd   = none;
        memory = shared;
    };

    worker_class dsp_core {
        simd   = neon128;
        memory = tightly_coupled[64KB] + shared;
    };

    worker_class rf_core {
        simd   = none;
        memory = shared;
    };

    memory_region sram_shared {
        size           = 128KB;
        accessible_by  = { fe_core, dsp_core, rf_core };
    };

    memory_region dsp_tcm {
        size           = 64KB;
        accessible_by  = { dsp_core };
        per_worker     = true;
    };

    workers = {
        fe  : fe_core,
        dsp : dsp_core,
        rf  : rf_core,
    };

    // ---------- data placement ----------

    // Audio frame buffers must be reachable by both producer and
    // consumer MCUs over the inter-MCU transport (UART hub —
    // TASK-0049.01), so they live in shared SRAM.
    place_data mic_in  in sram_shared;
    place_data bt_in   in sram_shared;
    place_data spk_out in sram_shared;
    place_data bt_out  in sram_shared;

    // ---------- kernel placement ----------

    place fe_capture  on fe;
    place fe_emit     on fe;

    place rf_receive  on rf;
    place rf_transmit on rf;

    place mix2        on dsp;
    place denoise     on dsp;     // both denoise firings (outbound and inbound) run on dsp

    // ---------- pipelining ----------

    // Three frames in flight so the three MCUs stay busy. This makes
    // FE capture frame N+2 while DSP processes frame N+1 and RF
    // transmits frame N.
    loop frame : pipeline=3;

    // ---------- IO semantics ----------

    // Mic and BT data into DSP: async with 3-deep buffering so FE/RF
    // can produce the next two frames while DSP works on the current
    // one. The buffer MUST be >= the loop's pipeline depth (3 above):
    // the link gate (TASK-0134 / PipelineExceedsBuffer) rejects a
    // pipelined cross-worker transfer whose ring is shallower than the
    // number of frames the schedule keeps in flight — otherwise frame
    // N+2's Push would overwrite frame N's still-unread slot. Matches
    // the pipeline-depth == buffer-capacity convention of examples
    // 09 (pipeline=4/buffer=4), 11 (2/2), 13 (3/3).
    //
    // NOTE (TASK-0192 M11 lowering-admission de-risk): the original
    // shape (initial commit 2cc372c, authored before the
    // PipelineExceedsBuffer link invariant existed) declared buffer=2
    // here while keeping pipeline=3 above — internally inconsistent
    // ("Three frames in flight" topology comment vs "2-deep buffering"
    // transfer comment). Bringing this schedule into the link/acfg
    // matrix surfaced the contradiction; buffer raised 2 -> 3 to match
    // the documented pipeline depth.
    transfer mic_in  : async, buffer=3, notify=event;
    transfer bt_in   : async, buffer=3, notify=event;

    // DSP output back to FE (speaker) and RF (Bluetooth tx): same
    // async pattern in the other direction (buffer == pipeline depth).
    transfer spk_out : async, buffer=3, notify=event;
    transfer bt_out  : async, buffer=3, notify=event;

    // ---------- runtime assertions (checkable, not prescriptive) ----------

    // A real hearing aid needs <10 ms ear-to-ear. v2 cannot SCHEDULE
    // to meet this constraint (no cost model). It can MEASURE
    // whether the actual scheduled execution meets it. If this
    // assertion fires during tier-1 differential testing or Renode
    // simulation, the schedule needs revision (more pipeline depth,
    // larger transfer buffer, kernel moved to a different MCU class,
    // etc).
    //
    // Default action is panic — loud failure during testing. For a
    // deployed product one would change to on_violation=log so an
    // occasional missed deadline doesn't brick the device.
    check loop frame : latency_max = 10ms;
}
