:name: nucleus-m10-embedded-ex1
:description: Inject input.bin, load the GENERATED embedded-pattern ex1 firmware, run bounded, capture USART1.

# The Renode runtime script for the embedded-pattern backend's M10 bin
# (TASK-0048.01 emission + TASK-0048.02 value-correctness). Unlike
# tests/renode/uart-smoke/run.resc (a hand-written sentinel firmware), the
# ELF this loads is GENERATED by
# `nucleus build --backend embedded-pattern --shim stm32h7` from example 1
# (01-elementwise-add, naive). The firmware loads REAL input from the
# injected region, computes c[i]=a[i]+b[i], and streams the RAW 1024
# output bytes over USART1; the `renode-embedded-ex1` just recipe `cmp`s
# the captured bytes BYTE-EXACT against reference.bin (PRD §10.3 point 3).
#
# Caller injects three path variables before `include`-ing this script:
#   $bin      = @<path to the cross-compiled GENERATED firmware ELF>
#   $uartFile = @<path the USART1 file backend writes to>
#   $input    = @<path to example 1's input.bin fixture>

mach create "h7"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl

# Deterministic file capture of USART1 (the STM32F7_USART model at
# 0x40011000). Second arg = overwrite-existing.
usart1 CreateFileBackend $uartFile true

# TASK-0048.02 real input path: inject the input fixture into axiSram @
# 0x24000000 BEFORE loading the firmware (and well before RunFor). axiSram
# is mapped in the platform (512K) but NOT in the firmware's memory.x
# linker map, so the stack/.bss never collide with the injected bytes. The
# firmware's Usart1Shim::alloc_in_region reads from this fixed address.
sysbus LoadBinary $input 0x24000000

sysbus LoadELF $bin

# Bounded virtual-time run — the firmware loads, computes, and streams its
# 1024 output bytes in microseconds, then spins. No wall-clock dependence,
# fully determinate.
emulation RunFor "0.05"
quit
