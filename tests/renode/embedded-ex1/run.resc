:name: nucleus-m10-embedded-ex1
:description: Load the GENERATED embedded-pattern example-1 firmware, run bounded, capture USART1.

# The Renode runtime script for the embedded-pattern backend's M10 bin
# (TASK-0048.01). Unlike tests/renode/uart-smoke/run.resc (a hand-written
# sentinel firmware), the ELF this loads is GENERATED by
# `nucleus build --backend embedded-pattern --shim stm32h7` from example 1
# (01-elementwise-add, naive). The firmware streams a deterministic ASCII
# summary line `NUC-EX1 len=1024 checksum=0` over USART1; the
# `renode-embedded-ex1` just recipe asserts it.
#
# Caller injects two path variables before `include`-ing this script:
#   $bin      = @<path to the cross-compiled GENERATED firmware ELF>
#   $uartFile = @<path the USART1 file backend writes to>

mach create "h7"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl

# Deterministic file capture of USART1 (the STM32F7_USART model at
# 0x40011000). Second arg = overwrite-existing.
usart1 CreateFileBackend $uartFile true

sysbus LoadELF $bin

# Bounded virtual-time run — the firmware emits its summary line in
# microseconds, then spins. No wall-clock dependence, fully determinate.
emulation RunFor "0.05"
quit
